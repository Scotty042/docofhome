# Optional separate MCP-only vhost; replace mcp.example.com before activation.
# No interactive Authentik login here. DocOfHome requires its own MCP token.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mcp.example.com;
    include /config/nginx/ssl.conf;
    include /config/nginx/resolver.conf;
    client_max_body_size 8m;
    location ~ ^/mcp(?:/|$) {
        access_log off; # Legacy token-in-path URLs must not enter request logs.
        include /config/nginx/proxy.conf;
        set $doh_upstream docofhome;
        proxy_pass http://$doh_upstream:8000;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
    location / { return 404; }
}
