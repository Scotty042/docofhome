{
  "name": "jarvis-frontend",
  "private": true,
  "version": "1.7.13.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-mdi-icons.mjs && vue-tsc --noEmit && vite build",
